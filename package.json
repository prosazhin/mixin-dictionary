{
  "name": "mixin-dictionary",
  "version": "1.7.0",
  "description": "Creating mixins from design tokens for LESS and SCSS.",
  "license": "MIT",
  "author": "Evgenii Sazhin <prosazhin@gmail.com> (https://prosazhin.dev)",
  "keywords": [
    "mixin dictionary",
    "mixin",
    "style dictionary",
    "style",
    "dictionary",
    "css",
    "less",
    "scss",
    "design",
    "tokens",
    "tool",
    "system",
    "design-tokens",
    "design-tool",
    "design-system",
    "dtcg",
    "design-tokens-format",
    "w3c-design-tokens"
  ],
  "homepage": "https://github.com/prosazhin/mixin-dictionary",
  "repository": {
    "type": "git",
    "url": "https://github.com/prosazhin/mixin-dictionary.git"
  },
  "bugs": {
    "url": "https://github.com/prosazhin/mixin-dictionary/issues"
  },
  "bin": {
    "mixin-dictionary": "./bin/mixin-dictionary.js"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./generate": {
      "types": "./types/generate.d.ts",
      "default": "./lib/generate.js"
    },
    "./schema/config.schema.json": "./schema/config.schema.json",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "bin",
    "lib",
    "schema",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,json}\"",
    "test": "node --test \"test/**/*.test.js\"",
    "test:types": "npm run build:types && tsc -p test/types/tsconfig.json",
    "build:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build:types",
    "prepare": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged --concurrent false",
    "pre-push": "npm run format",
    "commit-msg": "npx --no-install commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,json}": "prettier --write",
    "*.js": "eslint --cache --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "qs": "^6.16.0",
    "flatted": "^3.4.2",
    "fast-uri": "~3.1.6",
    "js-yaml": "^4.3.2",
    "@humanfs/node": "^0.16.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.7.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "json5": "^2.2.3",
    "style-dictionary": "^5.5.0"
  }
}
